---
/**
 * Der Download-Knopf.
 *
 * Solange `APP_STORE_URL` leer ist, gibt es nichts zu verlinken – der Knopf
 * sagt dann „Bald im App Store“ und ist kein Link. Sobald die Adresse in
 * `src/data/site.ts` steht, wird er von selbst zum Link.
 *
 * Apples Markenregeln: Das Apple-Logo dürfen Dritte nicht frei verwenden,
 * nur das unveränderte offizielle Badge. Liegt es als
 * `public/app-store-badge-de.svg` bereit (aus Apples „App Store Marketing
 * Tools“), zeigt der Knopf das Badge; sonst steht nur Text da.
 */
import { existsSync } from 'node:fs';
import { APP_STORE_URL } from '../data/site';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}
const { size = 'md', class: className = '', ...rest } = Astro.props;
const sizeClass = size === 'sm' ? 'btn--sm' : size === 'lg' ? 'btn--lg' : '';
const badge = APP_STORE_URL && existsSync(new URL('../../public/app-store-badge-de.svg', import.meta.url)) ? '/app-store-badge-de.svg' : '';
---

{
  APP_STORE_URL && badge ? (
    <a class:list={['badge', sizeClass, className]} {...rest} href={APP_STORE_URL} rel="noopener">
      <img src={badge} alt="Laden im App Store" width="120" height="40" decoding="async" />
    </a>
  ) : APP_STORE_URL ? (
    <a class:list={['btn', 'btn--primary', sizeClass, className]} {...rest} href={APP_STORE_URL} rel="noopener">
      <span>Im App Store laden</span>
    </a>
  ) : (
    <span class:list={['btn', 'btn--pending', sizeClass, className]} {...rest} title="Noch nicht veröffentlicht">
      <span>Bald im App Store</span>
    </span>
  )
}

<style>
  .btn--lg {
    min-height: 3.5rem;
    padding: 0 1.75rem;
    font-size: 1.0625rem;
  }

  /* Das offizielle Badge: unverändert, mit Luft, in Knopfhöhe */
  .badge {
    display: inline-flex;
    align-items: center;
  }

  .badge img {
    display: block;
    height: 3rem;
    width: auto;
  }

  .badge.btn--lg img {
    height: 3.5rem;
  }

  .badge.btn--sm img {
    height: 2.5rem;
  }
</style>
