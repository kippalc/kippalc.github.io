---
/**
 * Die Wertkurve – Linie mit Fläche darunter, wie im Kopf der Sammlung und
 * im Widget. Zeichnet sich beim Einblenden. Die Achse beginnt nicht bei
 * Null, sondern mit Luft um den Wertebereich (siehe README „Die Achse muss
 * mitwachsen“).
 */
interface Props {
  werte: number[];
  width?: number;
  height?: number;
  stroke?: number;
  farbe?: string;
  /** Punkte für gemessene Tage markieren (Index-Liste) */
  gemessen?: number[];
  /** Fläche unter der Kurve */
  fill?: boolean;
  /** Gestrichelte Bezugslinie, z. B. der Cardmarket-Durchschnitt der letzten 30 Tage */
  referenz?: { wert: number; label: string };
  class?: string;
  id?: string;
  [key: string]: unknown;
}

const {
  werte,
  width = 300,
  height = 80,
  stroke = 2.5,
  farbe = 'var(--up)',
  gemessen = [],
  fill = true,
  referenz,
  class: className = '',
  id = 'spark',
  ...rest
} = Astro.props;

const alle = referenz ? [...werte, referenz.wert] : werte;
const min = Math.min(...alle);
const max = Math.max(...alle);
const luft = (max - min) * 0.25 || 1;
const lo = min - luft;
const hi = max + luft;
const pad = stroke;
const x = (i: number) => pad + (i / (werte.length - 1)) * (width - pad * 2);
const y = (v: number) => pad + (1 - (v - lo) / (hi - lo)) * (height - pad * 2);

// Weiche Kurve über Catmull-Rom → Bézier
const pts = werte.map((v, i) => [x(i), y(v)] as const);
let d = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
for (let i = 0; i < pts.length - 1; i++) {
  const p0 = pts[Math.max(i - 1, 0)];
  const p1 = pts[i];
  const p2 = pts[i + 1];
  const p3 = pts[Math.min(i + 2, pts.length - 1)];
  const c1x = p1[0] + (p2[0] - p0[0]) / 6;
  const c1y = p1[1] + (p2[1] - p0[1]) / 6;
  const c2x = p2[0] - (p3[0] - p1[0]) / 6;
  const c2y = p2[1] - (p3[1] - p1[1]) / 6;
  d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
}
const area = `${d} L ${pts[pts.length - 1][0].toFixed(1)} ${height} L ${pts[0][0].toFixed(1)} ${height} Z`;
const gradId = `${id}-grad`;
---

<svg
  class:list={['spark', className]}
  {...rest}
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  preserveAspectRatio="none"
  aria-hidden="true"
  data-animate
  style={`--c:${farbe}`}
>
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={farbe} stop-opacity="0.32" />
      <stop offset="1" stop-color={farbe} stop-opacity="0" />
    </linearGradient>
  </defs>
  {fill && <path class="spark__area" d={area} fill={`url(#${gradId})`} />}
  {
    referenz && (
      <>
        <line class="spark__ref" x1={pad} x2={width - pad} y1={y(referenz.wert)} y2={y(referenz.wert)} />
        <text class="spark__ref-label" x={pad + 2} y={y(referenz.wert) - 4}>
          {referenz.label}
        </text>
      </>
    )
  }
  <path class="spark__line" d={d} fill="none" stroke={farbe} stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
  {
    gemessen.map((i) => (
      <circle class="spark__dot" cx={pts[i][0]} cy={pts[i][1]} r={stroke * 1.1} fill={farbe} />
    ))
  }
</svg>

<style>
  .spark {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .spark__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s var(--ease-out) 0.1s;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--c) 50%, transparent));
    vector-effect: non-scaling-stroke;
  }

  .spark__area {
    transition: opacity 0.9s ease-out 0.7s;
  }

  .spark__dot {
    transition: opacity 0.4s ease-out 1.3s;
  }

  .spark__ref {
    stroke: rgba(255, 255, 255, 0.35);
    stroke-width: 1;
    stroke-dasharray: 4 3;
    vector-effect: non-scaling-stroke;
  }

  .spark__ref-label {
    font-size: 9px;
    font-family: var(--font);
    fill: var(--text-muted);
  }

  /* Mit Skript zeichnet sich die Kurve erst beim Einblenden */
  :global(html.js) .spark:not(.is-in) .spark__line {
    stroke-dashoffset: 1;
  }

  :global(html.js) .spark:not(.is-in) .spark__area,
  :global(html.js) .spark:not(.is-in) .spark__dot {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .spark:not(.is-in) .spark__line {
      stroke-dashoffset: 0;
      transition: none;
    }

    :global(html.js) .spark:not(.is-in) .spark__area,
    :global(html.js) .spark:not(.is-in) .spark__dot {
      opacity: 1;
      transition: none;
    }
  }
</style>
