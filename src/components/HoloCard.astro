---
/**
 * Eine Sammelkarte, abstrakt: die Holo-Fläche aus dem App-Symbol im
 * Kartenformat 63:88, mit Platzhaltern statt Kartenkunst – und unten links
 * dem, was der Scanner liest: der Nummer und dem Set-Kürzel.
 *
 * Füllt seinen Elternteil (position: absolute; inset: 0). Der Elternteil
 * gibt Breite und Seitenverhältnis vor.
 */
interface Props {
  nummer?: string;
  code?: string;
  /** Farbwelt – „holo“ wie das Symbol, „gold“ für Geheimkarten, „reverse“ für Reverse-Folie */
  variante?: 'holo' | 'gold' | 'reverse' | 'plain';
  /** OCR-Markierung um die Nummer mitliefern (Scanner-Demo) */
  ocr?: boolean;
  /** Sheen-Animation */
  sheen?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { nummer = '199/165', code = 'MEW DE', variante = 'holo', ocr = false, sheen = true, class: className = '', ...rest } = Astro.props;
---

<!-- Nur Spans: die Karte darf auch in einem Knopf oder einer Zeile stehen; die Lagen sind ohnehin absolut gesetzt -->
<span class:list={['card', `card--${variante}`, className]} {...rest} aria-hidden="true">
  <span class="card__foil"></span>
  {sheen && <span class="card__sheen"></span>}
  <span class="card__head"><i></i><i></i></span>
  <span class="card__art"></span>
  <span class="card__lines"><i></i><i></i><i></i></span>
  <span class="card__foot">
    <span class="card__nr">{nummer}</span>
    {code && <span class="card__code">{code}</span>}
  </span>
  {ocr && <span class="card__ocr"></span>}
</span>

<style>
  .card {
    --cw: 100cqw;
    position: absolute;
    inset: 0;
    display: block;
    container-type: inline-size;
    border-radius: 5.2% / 3.72%;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      #1d2d52 0%,
      #2b2866 20%,
      #5a2a6a 38%,
      #8d2e6a 50%,
      #4d3b7e 62%,
      #1f6a63 78%,
      #14243a 100%
    );
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.18),
      0 24px 40px -16px rgba(0, 0, 0, 0.85),
      0 8px 14px -8px rgba(0, 0, 0, 0.7);
  }

  .card--gold {
    background: linear-gradient(135deg, #5a4210 0%, #a4801f 22%, #f0d36a 42%, #c9a03a 55%, #7d5d14 75%, #3f2e0a 100%);
  }

  .card--reverse {
    background:
      radial-gradient(90% 60% at 30% 20%, rgba(255, 255, 255, 0.16), transparent 60%),
      linear-gradient(135deg, #24355a 0%, #3a2f70 25%, #6a2c73 45%, #2f6d6f 70%, #1a2a44 100%);
  }

  .card--plain {
    background: linear-gradient(160deg, #3a3a40, #232328 60%, #1a1a1e);
  }

  .card__foil {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(118deg, rgba(255, 255, 255, 0) 0 6%, rgba(255, 255, 255, 0.05) 6% 8%, rgba(255, 255, 255, 0) 8% 14%),
      linear-gradient(160deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0) 45%);
  }

  .card--plain .card__foil {
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0) 45%);
  }

  .card__sheen {
    position: absolute;
    inset: -30%;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0) 38%,
      rgba(255, 255, 255, 0.22) 47%,
      rgba(200, 255, 230, 0.12) 52%,
      rgba(255, 255, 255, 0) 60%
    );
    animation: sheen 6.5s ease-in-out infinite;
  }

  @keyframes sheen {
    0%,
    100% {
      transform: translateX(-45%);
    }
    50% {
      transform: translateX(35%);
    }
  }

  .card__head {
    position: absolute;
    top: 5%;
    left: 7%;
    right: 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card__head i {
    display: block;
    height: 4.5cqw;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
  }

  .card__head i:first-child {
    width: 44%;
  }

  .card__head i:last-child {
    width: 16%;
    background: rgba(255, 255, 255, 0.35);
  }

  .card__art {
    position: absolute;
    top: 14%;
    left: 7%;
    right: 7%;
    height: 44%;
    border-radius: 2.5% / 1.8%;
    background:
      radial-gradient(60% 60% at 35% 40%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(0, 0, 0, 0.18));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  .card__lines {
    position: absolute;
    top: 63%;
    left: 8%;
    right: 8%;
    display: grid;
    gap: 4cqw;
  }

  .card__lines i {
    display: block;
    height: 2.8cqw;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.28);
  }

  .card__lines i:nth-child(2) {
    width: 82%;
  }

  .card__lines i:nth-child(3) {
    width: 58%;
  }

  .card__foot {
    position: absolute;
    left: 7%;
    bottom: 3.6%;
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    font-family: var(--font);
    font-size: 5.8cqw;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.6);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .card__code {
    font-size: 0.72em;
    font-weight: 600;
    opacity: 0.85;
  }

  .card__ocr {
    position: absolute;
    left: 4.5%;
    bottom: 1.4%;
    width: 44%;
    height: 9%;
    border-radius: 6cqw;
    border: 1.6cqw solid rgba(255, 255, 255, 0.95);
    box-shadow:
      0 0 10px rgba(255, 255, 255, 0.6),
      inset 0 0 10px rgba(255, 255, 255, 0.15);
    opacity: 0;
    transform: scale(1.15);
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .card__sheen {
      animation: none;
      transform: translateX(-10%);
    }
  }
</style>
