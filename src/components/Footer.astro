---
import { Image } from 'astro:assets';
import icon from '../assets/icon-1024.png';
import { ANBIETER, APP_STORE_URL, SITE } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Image src={icon} alt="" width={80} height={80} class="footer__icon" />
        <div>
          <p class="footer__name">{SITE.name}</p>
          <p class="footer__claim">Karten per Nummer erkennen.</p>
        </div>
      </div>

      <nav class="footer__cols" aria-label="Fußzeile">
        <div>
          <p class="footer__head">App</p>
          <a href="/#scannen">So funktioniert's</a>
          <a href="/#sammlung">Sammlung</a>
          <a href="/#preise">Preise</a>
          <a href="/#faq">FAQ</a>
          {APP_STORE_URL ? <a href={APP_STORE_URL} rel="noopener">App Store</a> : <a href="/#download">Download</a>}
        </div>
        <div>
          <p class="footer__head">Support</p>
          <a href={`mailto:${ANBIETER.email}`}>{ANBIETER.email}</a>
          <a href="/#faq">Häufige Fragen</a>
          <a href="/#daten">Deine Daten</a>
        </div>
        <div>
          <p class="footer__head">Rechtliches</p>
          <a href="/impressum.html">Impressum</a>
          <a href="/datenschutz.html">Datenschutz</a>
        </div>
      </nav>
    </div>

    <div class="hairline" role="presentation"></div>

    <div class="footer__bottom">
      <p class="footer__legal">
        {SITE.name} ist ein inoffizielles Hilfsmittel für Sammler und steht in keiner Verbindung zu Nintendo,
        The Pokémon Company International, Creatures Inc. oder GAME FREAK Inc. Alle genannten Marken gehören
        ihren jeweiligen Inhabern. Apple, iPhone, iOS und Siri sind Marken von Apple Inc., eingetragen in den USA
        und anderen Ländern; App Store ist eine Dienstleistungsmarke von Apple Inc. Kartendaten von TCGdex,
        Preisdaten aus der öffentlichen Preisliste von Cardmarket. Angezeigte Marktwerte sind Anhaltspunkte,
        keine Zusicherung und keine Anlageempfehlung.
      </p>
      <p class="footer__copy">© 2026 {ANBIETER.name}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 6rem) 2.5rem;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.02));
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 2fr);
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    align-self: start;
  }

  .footer__icon {
    width: 56px;
    height: 56px;
    border-radius: 13px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .footer__name {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }

  .footer__claim {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__cols > div {
    display: grid;
    align-content: start;
    gap: 0.6rem;
  }

  .footer__cols a {
    color: var(--text-soft);
    font-size: 0.9375rem;
    width: fit-content;
    transition: color 0.2s;
    overflow-wrap: anywhere;
  }

  .footer__cols a:hover {
    color: var(--text);
  }

  .footer__head {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .footer__bottom {
    display: grid;
    gap: 1.25rem;
    padding-top: 2rem;
  }

  .footer__legal {
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
    max-width: 62em;
    text-wrap: pretty;
  }

  .footer__copy {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  @media (max-width: 760px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
