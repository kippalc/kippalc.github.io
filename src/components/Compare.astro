---
/**
 * Vorher/Nachher zum Ziehen: links die Karte, wie eine Kamera sie oft sieht
 * – Glanz, Hülle, wenig Licht –, rechts das, was KippScan daraus liest: die
 * Nummer an der unteren Kante. Der Griff folgt Maus oder Finger; die
 * Tastatur bedient den versteckten Schieberegler.
 */
import HoloCard from './HoloCard.astro';
import Icon from './Icon.astro';

interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className = '', ...rest } = Astro.props;
---

<div class:list={['cmp', className]} {...rest} data-compare style="--pos: 52%">
  <div class="cmp__scene">
    <div class="cmp__layer cmp__layer--foto" aria-hidden="true">
      <div class="cmp__card">
        <HoloCard nummer="199/165" code="MEW DE" sheen={false} />
      </div>
      <div class="cmp__sleeve"></div>
      <div class="cmp__glare"></div>
    </div>
    <div class="cmp__layer cmp__layer--nummer" aria-hidden="true">
      <div class="cmp__card">
        <HoloCard nummer="199/165" code="MEW DE" sheen={false} ocr />
      </div>
      <p class="cmp__read num"><Icon name="check" size={12} stroke={3} />199/165 · MEW DE</p>
    </div>
    <div class="cmp__handle" aria-hidden="true">
      <span class="cmp__knob"><Icon name="chevron-up-down" size={16} stroke={2.4} /></span>
    </div>
  </div>
  <div class="cmp__labels" aria-hidden="true">
    <span>Was eine Kamera oft sieht</span>
    <span>Was KippScan liest</span>
  </div>
  <input class="cmp__range" type="range" min="4" max="96" value="52" aria-label="Vergleich verschieben: Kamerabild gegen gelesene Nummer" data-compare-range />
</div>

<style>
  .cmp {
    position: relative;
    width: 100%;
    max-width: 440px;
    user-select: none;
    -webkit-user-select: none;
  }

  .cmp__scene {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 20px;
    overflow: hidden;
    background: radial-gradient(110% 80% at 50% 20%, #2e2f35 0%, #1a1b1f 55%, #0d0d10 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .cmp__layer {
    position: absolute;
    inset: 0;
  }

  .cmp__card {
    position: absolute;
    left: 50%;
    top: 6%;
    width: 40%;
    aspect-ratio: 63 / 88;
    transform: translateX(-50%) rotate(-3deg);
  }

  .cmp__card :global(.card) {
    border-radius: 10px;
  }

  /* Die Folie: Blur, dunkler, ein harter Lichtreflex und die Hülle darüber */
  .cmp__layer--foto .cmp__card {
    filter: blur(1.6px) brightness(0.62) contrast(0.9);
  }

  .cmp__sleeve {
    position: absolute;
    left: 50%;
    top: 3%;
    width: 44%;
    aspect-ratio: 63 / 92;
    transform: translateX(-50%) rotate(-3deg);
    border-radius: 12px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.03) 45%, rgba(255, 255, 255, 0.1));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
  }

  .cmp__glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(28% 22% at 44% 30%, rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0) 70%),
      linear-gradient(115deg, rgba(255, 255, 255, 0) 30%, rgba(255, 255, 255, 0.28) 45%, rgba(255, 255, 255, 0) 55%);
    mix-blend-mode: screen;
  }

  .cmp__layer--nummer {
    clip-path: inset(0 0 0 var(--pos));
  }

  .cmp__layer--nummer :global(.card__ocr) {
    opacity: 1;
    transform: none;
    width: 62%;
    border-width: 2px;
    border-radius: 10px;
  }

  /* Das Gelesene, als Zeile – taucht auf, sobald der Griff weit genug links ist */
  .cmp__read {
    position: absolute;
    right: 5%;
    bottom: 5%;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem 0.32rem 0.55rem;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.78);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }

  .cmp__read :global(svg) {
    color: var(--up);
  }

  .cmp__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
    transform: translateX(-50%);
  }

  .cmp__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%) rotate(90deg);
    box-shadow:
      0 8px 24px -8px rgba(0, 0, 0, 0.8),
      0 0 0 4px rgba(10, 10, 10, 0.6);
  }

  .cmp__labels {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .cmp__labels span:last-child {
    color: var(--text);
    font-weight: 500;
    text-align: right;
  }

  /* Der Regler ist unsichtbar – Tastatur und Screenreader bedienen ihn, die Maus die Szene */
  .cmp__range {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    aspect-ratio: 4 / 3;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .cmp:has(.cmp__range:focus-visible) .cmp__scene {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Schmal: etwas höhere Bühne, damit die Nummer am unteren Kartenrand sichtbar bleibt */
  @media (max-width: 480px) {
    .cmp__scene,
    .cmp__range {
      aspect-ratio: 5 / 4;
    }

    .cmp__card {
      width: 44%;
    }

    .cmp__sleeve {
      width: 48%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-compare-range]');
    const scene = root.querySelector<HTMLElement>('.cmp__scene');
    if (!range || !scene) return;

    const setze = (p: number) => {
      const wert = Math.min(96, Math.max(4, p));
      root.style.setProperty('--pos', `${wert.toFixed(1)}%`);
      range.value = String(Math.round(wert));
    };

    range.addEventListener('input', () => setze(Number(range.value)));

    let aktiv = false;
    const ausPointer = (e: PointerEvent) => {
      const r = scene.getBoundingClientRect();
      setze(((e.clientX - r.left) / r.width) * 100);
    };
    scene.addEventListener('pointerdown', (e) => {
      aktiv = true;
      scene.setPointerCapture(e.pointerId);
      ausPointer(e);
    });
    scene.addEventListener('pointermove', (e) => {
      if (aktiv) ausPointer(e);
    });
    const ende = () => (aktiv = false);
    scene.addEventListener('pointerup', ende);
    scene.addEventListener('pointercancel', ende);
  });
</script>
