---
/**
 * Deine Sammlung, deine Daten – die Aussagen der Datenschutzerklärung und
 * des Über-Screens, verständlich gemacht. Nichts davon ist Marketing: kein
 * Konto, kein Server, kein Tracking, keine Werbenetzwerke, tägliche Sicherung.
 */
import Icon from '../Icon.astro';

const punkte = [
  { icon: 'lock', titel: 'Kein Konto, keine Anmeldung', text: 'Deine Sammlung, deine Fotos und deine Notizen bleiben auf dem iPhone. Niemand sonst sieht sie.' },
  { icon: 'eye', titel: 'Kein Tracking, keine Werbenetzwerke', text: 'Keine Analyse-, Werbe- oder Absturzberichtsdienste – die App fragt nicht einmal nach einer Tracking-Erlaubnis.' },
  { icon: 'camera', titel: 'Kein Bild verlässt das Gerät', text: 'Die Kamera liest auf dem iPhone. Nachgeschlagen wird nur, was gelesen wurde – nie das Foto.' },
  { icon: 'download', titel: 'Sicherung, täglich, von selbst', text: 'Jeden Tag eine vollständige Sicherung in „Dateien“. Dazu Export als CSV und PDF, jederzeit.' },
] as const;
---

<section class="data section" id="daten">
  <div class="container">
    <div class="data__grid">
      <div class="data__copy reveal">
        <h2 class="h2">Deine Sammlung. Deine Daten.</h2>
        <p class="lead">
          Ins Netz geht die App nur für Kartendaten und Preise. Alles andere bleibt, wo es hingehört.
        </p>
        <a class="btn btn--ghost btn--sm data__link" href="/datenschutz.html">
          Datenschutzerklärung lesen
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="data__points">
        {
          punkte.map((p, i) => (
            <li class="reveal" style={`--delay:${i * 0.07}s`}>
              <span class="data__icon">
                <Icon name={p.icon} size={20} />
              </span>
              <div>
                <h3>{p.titel}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</section>

<style>
  .data__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .data__copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
  }

  .data__link {
    margin-top: 0.5rem;
  }

  .data__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .data__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.5rem 0;
    border-top: 1px solid var(--hairline);
  }

  .data__points li > div {
    display: grid;
    gap: 0.4rem;
  }

  .data__icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--chip-fill);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    color: var(--text);
  }

  .data__points h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .data__points p {
    font-size: 0.9rem;
    color: var(--text-soft);
    text-wrap: pretty;
  }








  @media (max-width: 900px) {
    .data__grid {
      grid-template-columns: 1fr;
    }

    .data__copy {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .data__points {
      grid-template-columns: 1fr;
    }

    .data__points li {
      padding: 1.2rem 0;
    }
  }
</style>
