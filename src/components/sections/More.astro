---
/**
 * Was die App sonst noch kann – jede Kachel mit einem Stück Oberfläche,
 * nicht mit einem Symbol. Alles davon existiert (README, Store-Text).
 */
import Icon from '../Icon.astro';
import WidgetDemo from '../WidgetDemo.astro';
import { ZAHLEN } from '../../data/site';

const fmt = (n: number) => n.toLocaleString('de-DE');
---

<section class="more section" id="mehr">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <h2 class="h2">Was sonst noch drin ist.</h2>
      <p class="lead">Widget, gegradete Karten, versiegelte Ware, Listen zum Weitergeben – und alles, was eine Sammlung sonst noch braucht.</p>
    </div>

    <div class="bento" data-bento>
      <!-- Widget, Siri, Suchfeld -->
      <article class="tile glass glass--hover tile--wide reveal">
        <div class="tile__demo tile__demo--widget">
          <WidgetDemo />
        </div>
        <div class="tile__text">
          <h3>Widget, Siri und Suchfeld</h3>
          <p>
            Der Wert deiner Sammlung auf dem Home-Screen und dem Sperrbildschirm. „Was ist meine Sammlung in
            KippScan wert?“ – Siri sagt es, ohne die App zu öffnen.
          </p>
        </div>
      </article>

      <!-- Serienmodus -->
      <article class="tile glass glass--hover reveal" style="--delay:.05s">
        <div class="tile__demo">
          <div class="ui-series">
            <p class="ui-series__head"><Icon name="stack" size={15} stroke={2} /><span>Serie · 12 aufgenommen</span><b class="num up" data-preis>38,40 €</b></p>
            <p class="ui-series__last num"><span>Mew-ex</span><b class="up" data-preis>26,93 €</b></p>
          </div>
        </div>
        <div class="tile__text">
          <h3>Serienmodus</h3>
          <p>Ganze Stapel: Karte für Karte vor die Kamera, sichere Treffer landen ohne Tippen in der Sammlung.</p>
        </div>
      </article>

      <!-- Gegradet -->
      <article class="tile glass glass--hover reveal" style="--delay:.1s">
        <div class="tile__demo">
          <div class="ui-slab">
            <span class="ui-slab__label"><b>PSA</b><i>10</i><small>GEM MT</small></span>
            <span class="ui-slab__card"></span>
          </div>
        </div>
        <div class="tile__text">
          <h3>Gegradete Karten</h3>
          <p>PSA, BGS, CGC, SGC, ACE und TAG – mit hochgerechnetem Wert für Note und Jahrgang. Die PSA-Zertifikatsnummer liest die App vom Etikett.</p>
        </div>
      </article>

      <!-- Versiegelt -->
      <article class="tile glass glass--hover reveal" style="--delay:.15s">
        <div class="tile__demo">
          <ul class="ui-chips">
            <li>Display</li><li>Top-Trainer-Box</li><li>Booster</li><li>Tin</li><li>Blister</li><li>Box-Set</li><li>Themendeck</li>
          </ul>
        </div>
        <div class="tile__text">
          <h3>Versiegelte Ware</h3>
          <p>{fmt(ZAHLEN.versiegelteProdukte)} Produkte mit Tagespreis – Displays, Boxen, Booster, Tins. In derselben Sammlung wie deine Karten.</p>
        </div>
      </article>

      <!-- Export & Sicherung -->
      <article class="tile glass glass--hover reveal" style="--delay:.2s">
        <div class="tile__demo">
          <ul class="ui-files">
            <li><Icon name="doc" size={16} />kippscan-2026-09-16.csv<small>für Excel, mit Dezimalkomma</small></li>
            <li><Icon name="doc" size={16} />kippscan-inventar-2026-09-16.pdf<small>für Versicherung und Ordner</small></li>
            <li><Icon name="lock" size={16} />KippScan-Sicherung-2026-09-16.json<small>täglich von selbst in „Dateien“</small></li>
          </ul>
        </div>
        <div class="tile__text">
          <h3>Export und Sicherung</h3>
          <p>CSV für Excel, Inventarliste als PDF, vollständige Sicherung – täglich von selbst in „Dateien“.</p>
        </div>
      </article>

      <!-- Offline -->
      <article class="tile glass glass--hover reveal" style="--delay:.25s">
        <div class="tile__demo">
          <div class="ui-offline">
            <Icon name="wifi-slash" size={28} />
            <p><b class="num">{fmt(ZAHLEN.karten)}</b> Karten · <b class="num">{fmt(ZAHLEN.sets)}</b> Sets<br /><span>liegen in der App</span></p>
          </div>
        </div>
        <div class="tile__text">
          <h3>Funktioniert ohne Netz</h3>
          <p>Kartenliste und Preise liegen auf dem iPhone – scannen und nachschlagen geht auch ohne Netz.</p>
        </div>
      </article>

      <!-- Preise ausblenden -->
      <article class="tile glass glass--hover tile--wide tile--wide-end reveal" style="--delay:.3s">
        <div class="tile__demo tile__demo--toggle">
          <button type="button" class="ui-toggle" role="switch" aria-checked="false" data-preise-schalter>
            <span><Icon name="euro" size={18} />Preise ausblenden</span>
            <i class="ui-toggle__switch" aria-hidden="true"></i>
          </button>
          <p class="ui-toggle__hint" aria-live="polite">
            <span data-preis>Leg den Schalter um – Widget und Serienleiste oben ziehen mit.</span>
            <span data-ohne-preis hidden>So sieht die App aus: Widget und Serienleiste ohne eine Zahl.</span>
          </p>
        </div>
        <div class="tile__text">
          <h3>Sammeln ohne Zahlen</h3>
          <p>Ein Schalter, und keine Zahl mit Euro steht mehr in der App – auch nicht im Widget oder bei Siri. Für alle, die wegen der Karten sammeln.</p>
        </div>
      </article>
    </div>

    <p class="more__also reveal">
      Außerdem: Liste einlesen aus Notizen oder Tabellen · Tausch- und Fehllisten als Text · Verkaufsbuch mit
      Gewinn · Sammeln nach Illustrator · alle Drucke eines Pokémon · Notiz und eigene Fotos je Karte ·
      Foto-Modus statt Kamera · Stapelaktionen.
    </p>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .tile {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .tile--wide {
    grid-column: span 2;
    grid-template-rows: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
  }

  .tile__demo {
    display: grid;
    place-items: center;
    min-height: 150px;
    padding: 1.4rem;
    background:
      radial-gradient(70% 70% at 50% 20%, rgba(255, 255, 255, 0.04), transparent 70%),
      rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .tile--wide .tile__demo {
    min-height: 100%;
    border-bottom: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
    padding: 2rem 1.75rem;
  }

  .tile__text {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 1.4rem 1.5rem;
    align-content: start;
  }

  .tile__text h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tile__text p {
    font-size: 0.9rem;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  /* Serienleiste */
  .ui-series {
    width: min(100%, 300px);
    display: grid;
    gap: 0.4rem;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: rgba(28, 28, 30, 0.85);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    font-size: 0.875rem;
  }

  .ui-series__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .ui-series__head b {
    margin-left: auto;
    font-weight: 700;
  }

  .ui-series__last {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .ui-series__last b {
    font-weight: 600;
  }

  /* Slab */
  .ui-slab {
    position: relative;
    width: 96px;
    height: 136px;
    border-radius: 6px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.25),
      0 20px 30px -18px rgba(0, 0, 0, 0.9);
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 6px;
    gap: 6px;
  }

  .ui-slab__label {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 6px;
    padding: 4px 6px;
    border-radius: 3px;
    background: #f4f1e8;
    color: #111;
    font-size: 0.6875rem;
    line-height: 1.1;
  }

  .ui-slab__label b {
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #b1121b;
    grid-row: span 2;
    font-size: 0.8125rem;
  }

  .ui-slab__label i {
    font-style: normal;
    font-weight: 800;
    font-size: 0.875rem;
  }

  .ui-slab__label small {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #444;
  }

  .ui-slab__card {
    border-radius: 3px;
    background: linear-gradient(135deg, #1d2d52, #5a2a6a 45%, #1f6a63);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  /* Chips */
  .ui-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 280px;
  }

  .ui-chips li {
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* Dateien */
  .ui-files {
    width: min(100%, 300px);
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ui-files li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.6rem;
    align-items: center;
    padding: 0.5rem 0.7rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .ui-files svg {
    grid-row: span 2;
    color: var(--text-soft);
  }

  .ui-files small {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  /* Offline */
  .ui-offline {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
    color: var(--text-soft);
  }

  .ui-offline p {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--text);
  }

  .ui-offline span {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Schalter – echt: er schaltet die Preise in den Kacheln dieses Abschnitts */
  .tile__demo--toggle {
    align-content: center;
    gap: 0.75rem;
  }

  .ui-toggle {
    width: min(100%, 290px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    border-radius: 16px;
    background: rgba(28, 28, 30, 0.85);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    text-align: left;
    cursor: pointer;
    transition: box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .ui-toggle:hover {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
  }

  .ui-toggle span {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ui-toggle__switch {
    position: relative;
    width: 44px;
    height: 27px;
    border-radius: 999px;
    background: rgba(120, 120, 128, 0.36);
    flex: none;
    transition: background-color 0.25s;
  }

  .ui-toggle__switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 23px;
    height: 23px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s var(--ease-out);
  }

  .ui-toggle[aria-checked='true'] .ui-toggle__switch {
    background: var(--up);
  }

  .ui-toggle[aria-checked='true'] .ui-toggle__switch::after {
    transform: translateX(17px);
  }

  .ui-toggle__hint {
    width: min(100%, 290px);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .tile--wide-end .tile__demo {
    border-right: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.07);
  }

  .tile--wide-end .tile__text {
    order: -1;
  }

  .more__also {
    margin-top: 1.5rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--r-panel);
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  @media (max-width: 960px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .tile--wide {
      grid-column: auto;
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    .tile--wide .tile__demo {
      border-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      padding: 1.4rem;
    }
  }
</style>

<script>
  // „Preise ausblenden“ wie in der App: Ist der Schalter an, verschwinden die
  // Zeilen mit Euro – Widget, Serienleiste, Verkaufsblatt –, Listen bleiben.
  document.querySelectorAll<HTMLElement>('[data-bento]').forEach((bento) => {
    const schalter = bento.querySelector<HTMLButtonElement>('[data-preise-schalter]');
    if (!schalter) return;
    const mit = Array.from(bento.querySelectorAll<Element>('[data-preis]'));
    const ohne = Array.from(bento.querySelectorAll<Element>('[data-ohne-preis]'));
    const bilder = Array.from(bento.querySelectorAll<HTMLElement>('[data-label-ohne]'));
    bilder.forEach((b) => (b.dataset.labelMit = b.getAttribute('aria-label') ?? ''));

    const setze = (aus: boolean) => {
      schalter.setAttribute('aria-checked', String(aus));
      bento.classList.toggle('is-ohne-preise', aus);
      // toggleAttribute statt `.hidden`: SVG-Elemente kennen die Eigenschaft nicht
      mit.forEach((el) => el.toggleAttribute('hidden', aus));
      ohne.forEach((el) => el.toggleAttribute('hidden', !aus));
      bilder.forEach((b) => b.setAttribute('aria-label', (aus ? b.dataset.labelOhne : b.dataset.labelMit) ?? ''));
    };

    schalter.addEventListener('click', () => setze(schalter.getAttribute('aria-checked') !== 'true'));
  });
</script>
