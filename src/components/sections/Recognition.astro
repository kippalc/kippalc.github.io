---
/**
 * Was nach dem Scan dasteht. Das Ergebnisfeld groß, daneben die drei Dinge,
 * die es beantwortet – nach `CardResultView.swift` und `BestandZeile.swift`.
 */
import Icon from '../Icon.astro';
import ResultPanel from '../ResultPanel.astro';

const punkte = [
  {
    icon: 'sparkle',
    titel: 'Normal oder Reverse Holo – jede mit eigenem Preis',
    text: 'Ein Tipp, und der Preis stimmt für deinen Druck. Bei Dragoran aus „151“ heißt das 0,63 € oder 3,87 €.',
  },
  {
    icon: 'check-circle',
    titel: 'Ob du sie schon hast, steht sofort dabei',
    text: '„In der Sammlung: 2×“, „Auf deiner Wunschliste“ oder „Fehlt noch“ – die Frage, die man sich am Stand als Erstes stellt.',
  },
  {
    icon: 'plus',
    titel: 'Aufnehmen mit einem Tipp',
    text: 'In die Sammlung, als gegradete Karte oder erst mal auf die Wunschliste – mit dem Preis von heute. Die Marktplatz-Suche liegt einen Tipp daneben.',
  },
] as const;
---

<section class="rec section" id="scannen">
  <div class="container rec__grid">
    <div class="section-head rec__head reveal">
      <h2 class="h2">Scannen. Und alles über die Karte wissen.</h2>
      <p class="lead">
        Name, Set, Nummer und der Marktwert von heute – und ob du die Karte schon hast. Kein Tippen,
        kein Suchen.
      </p>
    </div>

    <div class="rec__copy">
      <ul class="rec__points">
        {
          punkte.map((p, i) => (
            <li class="reveal" style={`--delay:${0.08 + i * 0.07}s`}>
              <span class="rec__icon">
                <Icon name={p.icon} size={18} stroke={2} />
              </span>
              <div>
                <h3 class="rec__title">{p.titel}</h3>
                <p class="copy">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rec__visual reveal" style="--delay:.15s">
      <ResultPanel />
      <p class="rec__hint">Tippe auf Normal oder Reverse – die Zahlen sind echt, Stand 15.09.2026.</p>
    </div>
  </div>
</section>

<style>
  .rec__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-areas:
      'head visual'
      'copy visual';
    column-gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .rec__head {
    grid-area: head;
    margin-bottom: 2rem;
  }

  .rec__copy {
    grid-area: copy;
  }

  .rec__points {
    display: grid;
    gap: 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rec__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .rec__icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--chip-fill);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    color: var(--text);
    margin-top: 0.1rem;
  }

  .rec__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .rec__points .copy {
    font-size: 0.9375rem;
  }

  .rec__visual {
    grid-area: visual;
    display: grid;
    justify-items: center;
    gap: 1rem;
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
  }

  .rec__hint {
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 900px) {
    .rec__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'visual'
        'copy';
      row-gap: 2.5rem;
    }

    .rec__head {
      margin-bottom: 0;
    }

    .rec__visual {
      position: static;
    }
  }
</style>
