---
/**
 * Vier Zahlen, die aus der App kommen – kein Marketing, ein Inhaltsverzeichnis.
 */
import { ZAHLEN } from '../../data/site';

const fmt = (n: number) => n.toLocaleString('de-DE');

const fakten = [
  { zahl: fmt(ZAHLEN.karten), wert: ZAHLEN.karten, label: 'Karten im Verzeichnis', hint: 'liegt in der App, funktioniert ohne Netz' },
  { zahl: fmt(ZAHLEN.sets), wert: ZAHLEN.sets, label: 'Sets mit deutschen Namen', hint: 'Glurak heißt Glurak' },
  { zahl: '€', label: 'Preise vom europäischen Markt', hint: 'Cardmarkets öffentliche Tagesliste' },
  { zahl: '0', label: 'Konten, Tracker, Anzeigen', hint: 'alles bleibt auf dem Gerät' },
];
---

<section class="proof section--tight" aria-label="Zahlen zur App">
  <div class="container">
    <ul class="proof__list">
      {
        fakten.map((f, i) => (
          <li class="proof__item reveal" style={`--delay:${i * 0.07}s`}>
            <span class="proof__zahl num" data-count={f.wert}>{f.zahl}</span>
            <span class="proof__label">{f.label}</span>
            <span class="proof__hint">{f.hint}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proof {
    padding-block: 0 clamp(2rem, 5vw, 4rem);
  }

  .proof__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 1.75rem 0 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .proof__item {
    display: grid;
    gap: 0.15rem;
    padding-right: 1.5rem;
  }

  .proof__item + .proof__item {
    padding-left: 1.5rem;
    border-left: 1px solid var(--hairline);
  }

  .proof__zahl {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .proof__label {
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .proof__hint {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .proof__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.75rem;
    }

    .proof__item:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 480px) {
    .proof__list {
      grid-template-columns: 1fr;
      row-gap: 0;
    }

    .proof__item {
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      row-gap: 0.1rem;
      align-items: center;
      padding: 1rem 0;
      border-left: 0 !important;
      border-bottom: 1px solid var(--hairline);
    }

    .proof__item:last-child {
      border-bottom: 0;
    }

    .proof__zahl {
      grid-row: 1 / 3;
      min-width: 4.8rem;
      margin: 0;
      font-size: 1.75rem;
    }
  }
</style>

<script>
  // Die Zahlen zählen hoch, wenn die Leiste ins Bild kommt – einmal, kurz.
  const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = new Intl.NumberFormat('de-DE');
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    const ziel = Number(el.dataset.count);
    if (!ziel || reduziert || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const start = performance.now();
      const dauer = 1200;
      const tick = (t: number) => {
        const p = Math.min(1, (t - start) / dauer);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt.format(Math.round(ziel * eased));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.5 });
    io.observe(el);
  });
</script>
