---
/**
 * Die Nummer, nicht das Bild – in drei Schritten. Texte und Zustände nach
 * README „Wie erkannt wird“ und `ScannerScreen.swift`. Die Kandidaten sind
 * echt: „4/102“ ohne lesbaren Namen passt auf Glurak (Grundset) und
 * Piondragi (Triumph) – Preise aus der Cardmarket-Tagesliste vom 15.09.2026.
 */
import Compare from '../Compare.astro';
import HoloCard from '../HoloCard.astro';
import Icon from '../Icon.astro';
---

<section class="how section" id="scannen">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="h2">Die Nummer, nicht das Bild.</h2>
      <p class="lead">
        Jede Karte trägt an der unteren Kante, was sie eindeutig macht: Name, Sammlernummer und – seit
        Schwert &amp; Schild – das Set-Kürzel. KippScan liest genau das. Auf dem iPhone, mit Apples
        Texterkennung, ohne dass ein Bild das Gerät verlässt.
      </p>
    </div>

    <ol class="how__steps">
      <li class="how__step glass glass--hover reveal">
        <div class="how__visual how__visual--frame" aria-hidden="true">
          <div class="mini-frame">
            <div class="mini-frame__card"><HoloCard nummer="199/165" code="MEW DE" variante="holo" /></div>
            <i class="mini-frame__marker mini-frame__marker--l"></i>
            <i class="mini-frame__marker mini-frame__marker--r"></i>
          </div>
          <p class="mini-status"><Icon name="viewfinder" size={14} stroke={2.2} />Karte in den Rahmen halten</p>
        </div>
        <div class="how__text">
          <span class="how__nr num">1</span>
          <h3 class="h3">Karte in den Rahmen</h3>
          <p class="copy">
            Die Marker zeigen, wo die Nummer erwartet wird: unten links bei neueren Karten, unten rechts
            bei älteren. Hülle drauflassen – das stört nicht.
          </p>
        </div>
      </li>

      <li class="how__step glass glass--hover reveal" style="--delay:.1s">
        <div class="how__visual how__visual--edge" aria-hidden="true">
          <div class="edge">
            <div class="edge__card">
              <HoloCard nummer="199/165" code="MEW DE" sheen={false} ocr />
            </div>
            <ul class="edge__legend">
              <li><b class="num">199/165</b><span>Sammlernummer</span></li>
              <li><b>MEW</b><span>Set-Kürzel</span></li>
              <li><b>DE</b><span>Sprache</span></li>
            </ul>
          </div>
        </div>
        <div class="how__text">
          <span class="how__nr num">2</span>
          <h3 class="h3">Nummer lesen</h3>
          <p class="copy">
            Über mehrere Bilder liest die App Nummer, Set-Größe, Kürzel und Sprache und stimmt ab.
            Gemessen an 96 echten Karten aus zwölf Sets: Die Nummer stimmte in jedem Fall, der Name in 94 %.
          </p>
        </div>
      </li>

      <li class="how__step glass glass--hover reveal" style="--delay:.2s">
        <div class="how__visual how__visual--choice" aria-hidden="true">
          <div class="choice">
            <p class="choice__head">
              <Icon name="question" size={15} stroke={2.2} />
              <span>Welche Karte ist es?<small>2 Sets führen diese Nummer.</small></span>
            </p>
            <div class="choice__row">
              <div class="choice__thumb"><HoloCard nummer="4/102" code="" variante="holo" sheen={false} /></div>
              <span class="choice__meta"><b>Glurak</b><small>Grundset · Nr. 4</small></span>
              <span class="choice__price num">598,98 €</span>
            </div>
            <div class="choice__row">
              <div class="choice__thumb"><HoloCard nummer="4/102" code="" variante="plain" sheen={false} /></div>
              <span class="choice__meta"><b>Piondragi</b><small>Triumph · Nr. 4</small></span>
              <span class="choice__price num">5,52 €</span>
            </div>
            <p class="choice__none"><Icon name="search" size={13} stroke={2.4} />Keine davon – von Hand suchen</p>
          </div>
        </div>
        <div class="how__text">
          <span class="how__nr num">3</span>
          <h3 class="h3">Karte, Set, Preis</h3>
          <p class="copy">
            Der Name führt, das Kürzel benennt das Set, die Set-Größe grenzt ein. Passen mehrere Karten,
            fragt die App nach – mit Bild, Set und Preis je Kandidat – statt zu raten.
          </p>
        </div>
      </li>
    </ol>

    <div class="how__why">
      <div class="how__why-text reveal">
        <h3 class="h3">Warum die Nummer trägt, wo ein Bildabgleich aussteigt</h3>
        <p class="copy">
          Ein Foto verändert sich mit Licht, Winkel und Folie. Die aufgedruckte Nummer nicht. „Chaneira“
          gibt es in über 20 deutschen Sets – der Name allein reicht nicht. Und dieselbe Kartenzahl teilen sich
          oft mehrere Sets – die Nummer allein auch nicht. Erst zusammen ergeben sie einen Treffer.
        </p>
        <ul class="how__cases">
          <li><Icon name="layers" size={20} />In der Hülle</li>
          <li><Icon name="sparkle" size={20} />Auf glänzender Folie</li>
          <li><Icon name="bolt-slash" size={20} />Bei schwachem Licht</li>
          <li><Icon name="photo" size={20} />Auch aus einem Foto</li>
        </ul>
      </div>
      <div class="how__compare reveal" style="--delay:.1s">
        <Compare />
        <p class="how__compare-hint">Zieh den Griff – oder nutz die Pfeiltasten.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .how__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: schritt;
  }

  .how__step {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .how__visual {
    position: relative;
    height: 250px;
    display: grid;
    place-items: center;
    background:
      radial-gradient(70% 60% at 50% 30%, rgba(255, 255, 255, 0.05), transparent 70%),
      rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .how__text {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .how__nr {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .how__text .copy {
    font-size: 0.9375rem;
  }

  /* Schritt 1: der Rahmen */
  .mini-frame {
    position: relative;
    width: 136px;
    aspect-ratio: 63 / 88;
    border-radius: 12px;
    border: 2.5px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 0 9px rgba(255, 255, 255, 0.4),
      0 0 22px rgba(255, 255, 255, 0.2),
      0 0 0 200px rgba(0, 0, 0, 0.35);
    animation: atmen 2.3s ease-in-out infinite alternate;
  }

  @keyframes atmen {
    from {
      box-shadow:
        0 0 9px rgba(255, 255, 255, 0.1),
        0 0 22px rgba(255, 255, 255, 0.05),
        0 0 0 200px rgba(0, 0, 0, 0.35);
    }
    to {
      box-shadow:
        0 0 9px rgba(255, 255, 255, 0.45),
        0 0 22px rgba(255, 255, 255, 0.25),
        0 0 0 200px rgba(0, 0, 0, 0.35);
    }
  }

  .mini-frame__card {
    position: absolute;
    inset: 5% 6%;
    transform: rotate(-1.5deg);
  }

  .mini-frame__card :global(.card) {
    border-radius: 6px;
  }

  .mini-frame__marker {
    position: absolute;
    bottom: 3px;
    width: 30%;
    height: 5%;
    border: 1.5px dashed rgba(255, 255, 255, 0.55);
    border-radius: 4px;
  }

  .mini-frame__marker--l {
    left: 5%;
  }

  .mini-frame__marker--r {
    right: 5%;
  }

  .mini-status {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: rgba(28, 28, 30, 0.85);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    font-size: 0.8125rem;
    color: var(--text-soft);
    white-space: nowrap;
  }

  /* Schritt 2: die untere Kante, vergrößert */
  .edge {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Die Karte ist viel größer als der Ausschnitt – sichtbar bleibt die
     untere linke Ecke, dort steht, was gelesen wird. */
  .edge__card {
    position: absolute;
    left: 7%;
    bottom: 30%;
    width: 118%;
    max-width: 480px;
    aspect-ratio: 63 / 88;
  }

  .edge__card :global(.card) {
    border-radius: 24px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }

  .edge__card :global(.card__ocr) {
    opacity: 1;
    transform: none;
    width: 63%;
    border-width: 2.5px;
    border-radius: 12px;
    animation: ocr 2.6s ease-in-out infinite alternate;
  }

  @keyframes ocr {
    from {
      box-shadow:
        0 0 6px rgba(255, 255, 255, 0.3),
        inset 0 0 8px rgba(255, 255, 255, 0.08);
    }
    to {
      box-shadow:
        0 0 14px rgba(255, 255, 255, 0.7),
        inset 0 0 12px rgba(255, 255, 255, 0.18);
    }
  }

  .edge__legend {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.9rem 0.75rem;
    list-style: none;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.55) 40%);
  }

  .edge__legend li {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    min-width: 5.2rem;
    padding: 0.4rem 0.6rem;
    border-radius: 10px;
    background: rgba(28, 28, 30, 0.85);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .edge__legend b {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .edge__legend span {
    font-size: 0.6875rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* Schritt 3: die Auswahl */
  .choice {
    width: min(100% - 2rem, 300px);
    display: grid;
    gap: 0.4rem;
    padding: 0.8rem;
    border-radius: 16px;
    background: rgba(28, 28, 30, 0.85);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .choice__head {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-bottom: 0.3rem;
    color: var(--warn);
  }

  .choice__head span {
    display: grid;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
  }

  .choice__head small {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .choice__row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
  }

  .choice__thumb {
    position: relative;
    width: 34px;
    aspect-ratio: 63 / 88;
    flex: none;
  }

  .choice__thumb :global(.card) {
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
  }

  .choice__meta {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }

  .choice__meta b {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .choice__meta small {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .choice__price {
    margin-left: auto;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .choice__none {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
    padding-inline: 0.2rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text);
  }

  /* Warum */
  .how__why {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--hairline);
  }

  .how__why-text {
    display: grid;
    gap: 1.1rem;
  }

  .how__compare {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }

  .how__compare-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .how__cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .how__cases li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1.1rem;
    border-radius: var(--r-chip);
    background: var(--chip-fill);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .how__cases svg {
    color: var(--text-soft);
    flex: none;
  }

  @media (max-width: 960px) {
    .how__steps {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }

    .how__step {
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr);
    }

    .how__visual {
      height: 230px;
    }

    .how__why {
      grid-template-columns: 1fr;
      gap: 2rem;
      max-width: 560px;
      margin-inline: auto;
    }

    .how__compare {
      justify-items: stretch;
    }

    .how__compare :global(.cmp) {
      max-width: none;
    }

    .how__compare-hint {
      text-align: center;
    }
  }

  @media (max-width: 420px) {
    .how__cases {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-frame {
      animation: none;
    }
  }
</style>
