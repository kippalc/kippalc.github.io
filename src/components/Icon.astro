---
/**
 * Die Symbole der Seite – im Stil der SF Symbols, die die App benutzt:
 * eine Strichstärke, runde Enden, 24er-Raster. Inline, damit sie die
 * Schriftfarbe erben und nichts nachgeladen wird.
 */
export type IconName =
  | 'viewfinder'
  | 'grid'
  | 'stack'
  | 'info'
  | 'star'
  | 'star-fill'
  | 'seal'
  | 'search'
  | 'check-circle'
  | 'check'
  | 'circle-dashed'
  | 'bolt-slash'
  | 'photo'
  | 'arrow-up-right'
  | 'chevron-right'
  | 'chevron-down'
  | 'chevron-up-down'
  | 'eye'
  | 'plus'
  | 'plus-circle'
  | 'euro'
  | 'doc'
  | 'lock'
  | 'brush'
  | 'chart'
  | 'layers'
  | 'download'
  | 'refresh'
  | 'upload'
  | 'camera'
  | 'wifi-slash'
  | 'arrow-right'
  | 'menu'
  | 'close'
  | 'expand'
  | 'mail'
  | 'apple'
  | 'sparkle'
  | 'tag'
  | 'question';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  stroke?: number;
  label?: string;
  /** Weitere Attribute – u. a. der Scope der aufrufenden Komponente */
  [key: string]: unknown;
}

const { name, size = 20, class: className, stroke = 1.75, label, ...rest } = Astro.props;

