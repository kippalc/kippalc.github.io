  seal: '<path d="m12 3.5 2.3 1.6 2.8-.3 1 2.6 2.4 1.5-.6 2.8 1.3 2.5-2.1 1.9-.3 2.8-2.8.6-1.7 2.3-2.6-1.1-2.6 1.1-1.7-2.3-2.8-.6-.3-2.8-2.1-1.9 1.3-2.5-.6-2.8 2.4-1.5 1-2.6 2.8.3z"/><path d="m9.3 12.2 1.9 1.9 3.6-3.9"/>',
  search: '<circle cx="10.5" cy="10.5" r="6"/><path d="m15.2 15.2 4.3 4.3"/>',
