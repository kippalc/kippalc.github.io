---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Proof from '../components/sections/Proof.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Recognition from '../components/sections/Recognition.astro';
import Collection from '../components/sections/Collection.astro';
import Sets from '../components/sections/Sets.astro';
import Prices from '../components/sections/Prices.astro';
import Scenarios from '../components/sections/Scenarios.astro';
import More from '../components/sections/More.astro';
import Gallery from '../components/sections/Gallery.astro';
import Data from '../components/sections/Data.astro';
import Faq from '../components/sections/Faq.astro';
import Download from '../components/sections/Download.astro';
import { SITE } from '../data/site';
---

<Base title={`${SITE.name} – Pokémon-Karten per Nummer erkennen`} path="/" withAppSchema>
  <Hero />
  <Proof />
  <HowItWorks />
  <Recognition />
  <Collection />
  <Sets />
  <Prices />
  <Scenarios />
  <More />
  <Gallery />
  <Data />
  <Faq />
  <Download />
</Base>
