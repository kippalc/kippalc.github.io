---
/**
 * Vorlage für das Social-Preview-Bild (1200 × 630). Wird nicht verlinkt und
 * nicht in die Sitemap aufgenommen; `public/og.png` entsteht daraus per
 * Bildschirmfoto (siehe README).
 */
import '../../styles/global.css';
import { Image } from 'astro:assets';
import icon from '../../assets/icon-1024.png';
import HoloCard from '../../components/HoloCard.astro';
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG</title>
  </head>
  <body>
    <div class="og">
      <div class="og__light"></div>
      <div class="og__copy">
        <div class="og__brand">
          <Image src={icon} alt="" width={160} height={160} class="og__icon" />
          <span>KippScan</span>
          <span class="og__pill">für iPhone</span>
        </div>
        <h1>Karte scannen.<br /><span>Wert sehen.</span></h1>
        <p>Karten per Nummer erkennen. Cardmarket-Preise in Euro.<br />Deine Sammlung, komplett auf dem iPhone.</p>
      </div>
      <div class="og__visual">
        <div class="og__frame">
          <div class="og__card"><HoloCard nummer="199/165" code="MEW DE" sheen={false} /></div>
          <i class="og__marker og__marker--l"></i>
          <i class="og__marker og__marker--r"></i>
        </div>
        <div class="og__result">
          <b>Glurak-ex</b>
          <small>151 · Nr. 199</small>
          <strong class="num">422,69 €</strong>
        </div>
      </div>
    </div>
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }

      body::before {
        display: none;
      }

      .og {
        position: relative;
        width: 1200px;
        height: 630px;
        display: grid;
        grid-template-columns: 640px 1fr;
        align-items: center;
        padding: 0 0 0 80px;
        background: #0a0a0a;
        overflow: hidden;
      }

      .og__light {
        position: absolute;
        inset: -30% -10% auto -10%;
        height: 80%;
        background: radial-gradient(50% 60% at 50% 40%, rgba(255, 255, 255, 0.09), transparent 70%);
      }

      .og__copy {
        position: relative;
        display: grid;
        gap: 28px;
      }

      .og__brand {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .og__icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16);
      }

      .og__pill {
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.09);
        font-size: 18px;
        font-weight: 500;
        color: var(--text-soft);
      }

      h1 {
        font-size: 92px;
        font-weight: 800;
        letter-spacing: -0.045em;
        line-height: 0.96;
      }

      h1 span {
        background: linear-gradient(180deg, #fff 0%, rgba(255, 255, 255, 0.5) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .og__copy p {
        font-size: 26px;
        line-height: 1.35;
        color: var(--text-soft);
      }

      .og__visual {
        position: relative;
        height: 100%;
      }

      .og__frame {
        position: absolute;
        left: 40px;
        top: 60px;
        width: 320px;
        aspect-ratio: 63 / 88;
        border-radius: 22px;
        border: 4px solid rgba(255, 255, 255, 0.95);
        box-shadow:
          0 0 18px rgba(255, 255, 255, 0.5),
          0 0 60px rgba(255, 255, 255, 0.2);
      }

      .og__card {
        position: absolute;
        inset: 5% 6%;
        transform: rotate(-2deg);
      }

      .og__marker {
        position: absolute;
        bottom: 2%;
        width: 30%;
        height: 5%;
        border: 2px dashed rgba(255, 255, 255, 0.5);
        border-radius: 6px;
      }

      .og__marker--l {
        left: 5%;
      }

      .og__marker--r {
        right: 5%;
      }

      .og__result {
        position: absolute;
        left: 180px;
        top: 340px;
        display: grid;
        gap: 4px;
        padding: 24px 28px;
        border-radius: 24px;
        background: rgba(28, 28, 30, 0.9);
        box-shadow:
          inset 0 0 0 1px rgba(255, 255, 255, 0.14),
          0 30px 60px -20px rgba(0, 0, 0, 0.9);
        min-width: 260px;
      }

      .og__result b {
        font-size: 26px;
        font-weight: 700;
      }

      .og__result small {
        font-size: 17px;
        color: var(--text-soft);
      }

      .og__result strong {
        margin-top: 8px;
        font-size: 44px;
        font-weight: 700;
        text-shadow: 0 0 14px rgba(255, 255, 255, 0.3);
      }
    </style>
  </body>
</html>
